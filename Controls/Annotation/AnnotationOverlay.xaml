<UserControl x:Class="ApertureNeo.Controls.Annotation.AnnotationOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:annot="clr-namespace:ApertureNeo.Controls.Annotation;assembly="
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="48" d:DesignWidth="800">

    <Border Background="{DynamicResource SurfacePanel}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Drawing tools group: Clear / Undo.
                 Pen is always "on" while the toolbar is visible
                 (entering annotation mode = pen is on, exiting =
                 toolbar gone). So no Pen toggle here — the
                 annotation mode itself is the toggle. -->
            <Button Content="清空" Style="{DynamicResource LinearToolButton}"
                    Click="Clear_Click"/>
            <Button Content="撤销" Style="{DynamicResource LinearToolButton}"
                    Margin="6,0,0,0" Click="Undo_Click"/>

            <Rectangle Style="{DynamicResource LinearToolbarSeparator}"/>

            <!-- Color group: 7 RadioButtons styled as color
                 circles. The selected one is shown with a brand
                 ring (via the LinearColorCircle template). Tag
                 is a hex string consumed by the ColorBtn_Click
                 handler. -->
            <TextBlock Text="颜色" Style="{DynamicResource LinearSubtleLabel}" Margin="0,0,8,0"/>
            <RadioButton x:Name="ColorRedBtn" Width="22" Height="22" Margin="0,0,4,0"
                          GroupName="AnnotationColor" IsChecked="True"
                          Tag="#FFE11D48"
                          Click="ColorBtn_Click"
                          Style="{DynamicResource LinearColorCircle}"/>
            <RadioButton x:Name="ColorOrangeBtn" Width="22" Height="22" Margin="0,0,4,0"
                          GroupName="AnnotationColor"
                          Tag="#FFEA580C"
                          Click="ColorBtn_Click"
                          Style="{DynamicResource LinearColorCircle}"/>
            <RadioButton x:Name="ColorYellowBtn" Width="22" Height="22" Margin="0,0,4,0"
                          GroupName="AnnotationColor"
                          Tag="#FFEAB308"
                          Click="ColorBtn_Click"
                          Style="{DynamicResource LinearColorCircle}"/>
            <RadioButton x:Name="ColorGreenBtn" Width="22" Height="22" Margin="0,0,4,0"
                          GroupName="AnnotationColor"
                          Tag="#FF16A34A"
                          Click="ColorBtn_Click"
                          Style="{DynamicResource LinearColorCircle}"/>
            <RadioButton x:Name="ColorBlueBtn" Width="22" Height="22" Margin="0,0,4,0"
                          GroupName="AnnotationColor"
                          Tag="#FF2563EB"
                          Click="ColorBtn_Click"
                          Style="{DynamicResource LinearColorCircle}"/>
            <RadioButton x:Name="ColorBlackBtn" Width="22" Height="22"
                          GroupName="AnnotationColor"
                          Tag="#FF1a1a1a"
                          Click="ColorBtn_Click"
                          Style="{DynamicResource LinearColorCircle}"/>
            <RadioButton x:Name="ColorWhiteBtn" Width="22" Height="22" Margin="4,0,0,0"
                          GroupName="AnnotationColor"
                          Tag="#FFFFFFFF"
                          Click="ColorBtn_Click"
                          Style="{DynamicResource LinearColorCircle}"/>

            <Rectangle Style="{DynamicResource LinearToolbarSeparator}"/>

            <!-- Size group: 5 RadioButtons showing 2/4/8/12/20. -->
            <TextBlock Text="粗细" Style="{DynamicResource LinearSubtleLabel}" Margin="0,0,6,0"/>
            <RadioButton x:Name="Size2Btn" Content="2" GroupName="AnnotationSize"
                          Style="{DynamicResource LinearPenSizeToggle}"
                          Click="SizeBtn_Click"/>
            <RadioButton x:Name="Size4Btn" Content="4" GroupName="AnnotationSize" IsChecked="True"
                          Style="{DynamicResource LinearPenSizeToggle}"
                          Margin="3,0,0,0" Click="SizeBtn_Click"/>
            <RadioButton x:Name="Size8Btn" Content="8" GroupName="AnnotationSize"
                          Style="{DynamicResource LinearPenSizeToggle}"
                          Margin="3,0,0,0" Click="SizeBtn_Click"/>
            <RadioButton x:Name="Size12Btn" Content="12" GroupName="AnnotationSize"
                          Style="{DynamicResource LinearPenSizeToggle}"
                          Margin="3,0,0,0" Click="SizeBtn_Click"/>
            <RadioButton x:Name="Size20Btn" Content="20" GroupName="AnnotationSize"
                          Style="{DynamicResource LinearPenSizeToggle}"
                          Margin="3,0,0,0" Click="SizeBtn_Click"/>

            <!-- Right-side spacer pushes the Save action to the
                 far edge. -->
            <Grid Width="*" />

            <Button Content="保存" Style="{DynamicResource LinearPrimaryButton}"
                    Click="Save_Click" Margin="0"/>
        </StackPanel>
    </Border>
</UserControl>
