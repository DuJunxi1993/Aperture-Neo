<ui:FluentWindow x:Class="ApertureNeo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ApertureNeo.Controls;assembly="
        xmlns:behaviors="clr-namespace:ApertureNeo.Controls;assembly="
        xmlns:tree="clr-namespace:ApertureNeo.Controls.FolderTree;assembly="
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ApertureNeo.Views"
        Title="Aperture Neo · Linear"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource SurfaceCanvas}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.DirectionalNavigation="None"
        WindowBackdropType="None"
        WindowStyle="SingleBorderWindow"
        AllowDrop="True">

    <!-- WindowChrome: customize the non-client area so the OS
         draws a fully dark border that matches our Linear
         canvas. CaptionHeight=44 lets the top row drag the
         window. ResizeBorderThickness=0 + GlassFrameThickness=0
         give a chrome-less look. UseAeroCaptionButtons=True
         keeps the min/max/close in the upper right. -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar (44px). All internal layout lives in TitleBarView. -->
        <views:TitleBarView Grid.Row="0" x:Name="TitleBar"/>

        <!-- Main 3-column layout: tree | thumbnails | viewer (with overlays) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="1*" MinWidth="180"/>
                <ColumnDefinition x:Name="TreeSplitterColumn" Width="Auto"/>
                <ColumnDefinition x:Name="ThumbColumn" Width="1*" MinWidth="160"/>
                <ColumnDefinition x:Name="ThumbSplitterColumn" Width="6"/>
                <ColumnDefinition x:Name="ViewerColumnDef" Width="4*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <views:FolderTreePanelView Grid.Column="0" x:Name="TreePanelView"/>

            <GridSplitter Grid.Column="1" x:Name="TreeSplitter" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False"/>

            <views:ThumbnailPanelView Grid.Column="2" x:Name="ThumbPanelView"/>

            <GridSplitter Grid.Column="3" x:Name="ThumbSplitter"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False"/>

            <!-- Image viewer + its floating overlays (the viewer is
                 a pure SkiaImageViewer; the overlays sit at
                 Panel.ZIndex=10 above it). -->
            <Grid Grid.Column="4" ClipToBounds="False">
                <views:ImageViewerPanelView x:Name="ViewerPanel" Panel.ZIndex="0"/>

                <!-- Floating overlays at Panel.ZIndex=10 sit ABOVE
                     the SkiaImageViewer for hit-testing. Empty
                     regions of the Grid (no Background) are
                     hit-test transparent and pass events through. -->
                <Grid x:Name="FloatingOverlayHost" Panel.ZIndex="10">
                    <views:FloatingBarView x:Name="FloatingBar"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>

                    <views:InfoPillView x:Name="InfoPill"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                                         Visibility="{Binding ElementName=ViewerPanel, Path=DataContext.IsAnnotating, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <!-- Info popover. Placement + right-align is computed
                         in code; the body lives in InfoPopoverView. -->
                    <Popup x:Name="InfoPopover"
                           PlacementTarget="{Binding ElementName=InfoPill}"
                           Placement="Bottom"
                           HorizontalOffset="0"
                           VerticalOffset="0"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="Fade"
                           IsOpen="False"
                           Closed="InfoPopover_Closed">
                        <views:InfoPopoverView x:Name="InfoPopoverBody"/>
                    </Popup>

                    <!-- Edge navigation buttons (fullscreen only). -->
                    <views:EdgeNavView x:Name="EdgeNavLeft" Direction="Left"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,0,0"
                                       Visibility="Collapsed" Opacity="0"/>
                    <views:EdgeNavView x:Name="EdgeNavRight" Direction="Right"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,48,0"
                                       Visibility="Collapsed" Opacity="0"/>

                    <!-- Exit-fullscreen pill (fullscreen only). -->
                    <views:ExitFullscreenHintView x:Name="ExitFullscreenHintView"
                                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
                                                  Visibility="Collapsed" Opacity="0"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 8px left-edge hot zone + floating tree popup (collapsed
             tree mode). These are fullscreen-aware and stay in
             MainWindow because the cross-window state is simpler
             to manage here. -->
        <Rectangle x:Name="TreeHotZone" Grid.Row="1"
                   Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Fill="Transparent"
                   IsHitTestVisible="True"
                   MouseEnter="TreeHotZone_MouseEnter"
                   MouseLeave="TreeHotZone_MouseLeave"
                   Visibility="Collapsed"/>

        <Popup x:Name="TreeFloatingPopup"
               Placement="Left" PlacementTarget="{Binding ElementName=TreeHotZone}"
               HorizontalOffset="0" VerticalOffset="0"
               AllowsTransparency="False"
               PopupAnimation="Fade"
               StaysOpen="True"
               IsOpen="False"
               Closed="TreeFloatingPopup_Closed">
            <Border x:Name="TreeFloatingPanel"
                    Background="{StaticResource SurfacePanel}"
                    BorderBrush="{StaticResource BorderStandard}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Width="248" MaxHeight="600"
                    Margin="0,4,0,0"
                    Padding="0,4"
                    MouseLeave="TreeFloatingPanel_MouseLeave"
                    MouseEnter="TreeFloatingPanel_MouseEnter">
                <Border.Effect>
                    <StaticResource ResourceKey="ShadowDialog"/>
                </Border.Effect>
                <tree:FolderTreeView x:Name="FolderTreeFloating"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     Padding="0,4"/>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>