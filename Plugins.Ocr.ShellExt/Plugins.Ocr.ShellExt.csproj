<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Targeting net10.0-windows (no specific Win10 SDK version)
         so the .NET 10 SDK doesn't implicitly pull the
         WindowsAppSDK runtime pack as a dependency. The shell
         extension only uses classic COM interfaces
         (IUnknown / IShellItem / IShellItemArray / IBindCtx /
         IExplorerCommand) which are all available in the base
         net10.0-windows TFM without the SDK 19041 reference
         pack. Using the more specific net10.0-windows10.0.19041.0
         TFM (the previous value) made deps.json reference
         Microsoft.Windows.SDK.NET.Ref, a 7MB WindowsAppSDK
         runtime pack that the shell ext never actually used —
         but its absence from the publish output caused COM
         activation to throw FileNotFoundException silently,
         dropping the verb entirely. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ApertureNeo.Plugins.Ocr.ShellExt</RootNamespace>
    <AssemblyName>ApertureNeo.Plugins.Ocr.ShellExt</AssemblyName>
    <!-- No WPF, no WinForms. The shell extension is a pure
         COM in-proc server that spawns a child process for the
         actual OCR work, so it doesn't need a UI thread.
         EnableComHosting (Plan D): generates a native comhost.dll
         alongside the managed DLL. Without this, .NET COM in-proc
         activation relies on mscoree.dll + runtimeconfig.json —
         but .NET Library projects never generate runtimeconfig.json,
         so the COM activator can't find the runtime and fails
         silently. EnableComHosting produces a lightweight native
         shim (comhost.dll) that the OS loads directly; the shim
         then loads the .NET runtime + resolves assemblies from
         the same directory and instantiates the managed COM class.
         This is the official .NET 6+ COM server path. -->
    <EnableComHosting>true</EnableComHosting>
    <!-- RuntimeIdentifier is required for EnableComHosting. The
         self-contained publish bundles the .NET runtime alongside
         the comhost so the shim can find it without depending on
         a system-wide .NET install. Duplicates ~60 MB of runtime
         DLLs already in the main app's {app} directory, which is
         acceptable for reliability of COM activation. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- We expose a class via [ComVisible] + [Guid]; the GUID
         below is fixed (chosen once) so the installer's
         registry entries and the in-proc server match across
         versions. The CLSID is intentionally separate from the
         main ApertureNeo CLSID to keep the COM activation
         surface stable even if the host exe's GUID changes. -->
    <DefineConstants>$(DefineConstants);OCR_SHELL_EXT_CLSID</DefineConstants>
  </PropertyGroup>

  <!-- The shell extension runs in the Explorer process and is
       loaded by the Windows shell via standard COM activation.
       Its dependencies must be available in the same load
       context. We declare the COM interfaces (IExplorerCommand,
       IShellItemArray, IShellItem, IBindCtx) manually via
       [ComImport] + [InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
       — they're all stable Windows APIs and the manual approach
       avoids the Microsoft.Windows.SDK.NET.Ref package which is
       not yet .NET-10-compatible. The shell extension doesn't
       reference the main app; at Invoke time it spawns
       ApertureNeo.exe (the in-proc server path comes from the
       installer's [Registry] entry — {app}\Plugins\ApertureNeo.Plugins.Ocr.ShellExt.dll). -->

</Project>
