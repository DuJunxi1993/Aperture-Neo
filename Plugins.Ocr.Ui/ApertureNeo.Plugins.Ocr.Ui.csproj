<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ApertureNeo.Plugins.Ocr.Ui</RootNamespace>
    <AssemblyName>ApertureNeo.Plugins.Ocr.Ui</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Disable the default Page glob so we can declare both XAML
         files explicitly with the right Generator/SubType metadata. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- The OcrResultWindow depends on OcrResult/OcrLine (model types)
       and the Linear design tokens resource dictionary bundled here.
       ApertureNeo.Strings gives us the localized text for the
       status bar, segmented controls, etc. (OcrWindow_*) so this
       DLL doesn't hard-code Chinese — it reads the same .resx the
       main app uses, guaranteeing the two stay in sync. -->
  <ItemGroup>
    <ProjectReference Include="..\Plugins.Ocr.Core\ApertureNeo.Plugins.Ocr.Core.csproj"/>
    <ProjectReference Include="..\ApertureNeo.Strings\ApertureNeo.Strings.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Page Include="OcrResultWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="DesignTokens.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>