<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Linear design tokens (light mode snapshot of DesignTokens.xaml in
         the main project). Embedded here so the OCR plugin's UI window
         stays self-contained and doesn't depend on the host's resource
         dictionaries. Keep in sync if main project's DesignTokens
         changes substantially. -->

    <FontFamily x:Key="FontPrimary">HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <CornerRadius x:Key="RadiusStd">4</CornerRadius>
    <CornerRadius x:Key="RadiusComfy">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">12</CornerRadius>

    <SolidColorBrush x:Key="SurfaceCanvas"     Color="#FFfafafa"/>
    <SolidColorBrush x:Key="SurfacePanel"      Color="#FFf4f4f5"/>
    <SolidColorBrush x:Key="SurfaceElevated"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceCardHover"  Color="#FFF6F6F8"/>
    <SolidColorBrush x:Key="SurfaceHover"      Color="#FFE8E8EB"/>

    <SolidColorBrush x:Key="TextPrimary"   Color="#FF1a1a1a"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF4a4a52"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="#FF8a8f98"/>
    <SolidColorBrush x:Key="TextQuat"      Color="#FFa8aab2"/>

    <SolidColorBrush x:Key="BrandPrimary"  Color="#FF5e6ad2"/>
    <SolidColorBrush x:Key="FocusRing"     Color="#FF5e6ad2"/>

    <SolidColorBrush x:Key="BorderSubtle"   Color="#12000000"/>
    <SolidColorBrush x:Key="BorderStandard" Color="#1F000000"/>
    <SolidColorBrush x:Key="BorderSolid"    Color="#FFE5E5E8"/>
    <SolidColorBrush x:Key="BorderStrong"   Color="#FFBBBBBB"/>

    <SolidColorBrush x:Key="BtnBgGhost"  Color="#08000000"/>
    <SolidColorBrush x:Key="BtnBgHover"  Color="#14000000"/>
    <SolidColorBrush x:Key="BtnBgPress"  Color="#1F000000"/>

    <SolidColorBrush x:Key="StatusRed"   Color="#FFdc2626"/>
    <SolidColorBrush x:Key="StatusGreen" Color="#FF16a34a"/>

    <!-- Selection (matches main project's SelectionBg/SelectionFg — light
         indigo tint for selected segmented items). -->
    <SolidColorBrush x:Key="SelectionBg"   Color="#FFe0e1ff"/>
    <SolidColorBrush x:Key="SelectionFg"   Color="#FF3a4099"/>

    <!-- Close-button hover/press (matches main project's CloseBgHover/Press
         + the #ef4444 foreground used by LinearCloseButton). -->
    <SolidColorBrush x:Key="CloseBgHover" Color="#1AE81123"/>
    <SolidColorBrush x:Key="CloseBgPress" Color="#3CE81123"/>
    <SolidColorBrush x:Key="CloseFgHover" Color="#FFef4444"/>

    <!-- Card shadow: matches the main project's ShadowDialog token
         (DesignTokens.xaml) so the OCR window's drop shadow is
         visually consistent with the About window and the floating
         panels. BlurRadius=24 ShadowDepth=8 Opacity=0.18.
         ShadowDepth=8 means the shadow is offset 8px down from the
         element, so the Window.Template margin is asymmetric
         (16 on top/left/right, 32 on bottom) to give the shadow
         room to render without being clipped at the window edge. -->
    <DropShadowEffect x:Key="ShadowDialog" BlurRadius="24" ShadowDepth="8" Opacity="0.18" Color="Black"/>

    <!-- Linear focus visual: 2px indigo ring -->
    <Style x:Key="LinearFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2"
                               Stroke="{StaticResource FocusRing}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eyebrow label (11px / 510 / TextTertiary) -->
    <Style x:Key="LinearEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="510"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Value line (13px / 510 / TextPrimary) -->
    <Style x:Key="LinearValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="510"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Mono value (12px / 400 / TextSecondary) -->
    <Style x:Key="LinearMonoValue" TargetType="TextBlock" BasedOn="{StaticResource LinearValue}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontWeight" Value="400"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <!-- 1px hairline divider -->
    <Style x:Key="LinearHairline" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="Margin" Value="0,14,0,14"/>
    </Style>

    <!-- Flat icon button (28×28, mirrors LinearWindowButton from the
         main project). -->
    <Style x:Key="LinearIconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgHover}"/>
                            <Setter TargetName="border" Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary CTA (indigo). 28px tall, 6px corners, like
         LinearPrimaryButton. -->
    <Style x:Key="LinearPrimaryCta" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontWeight" Value="600"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusStd}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF9aa6ff"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF7170ff"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close icon button (28x28, subtle red wash on hover/press) — the
         destructive variant of LinearIconButton, matching the main
         project's LinearCloseButton. The red wash + red glyph gives
         the user a clear hint that this action closes the window. -->
    <Style x:Key="LinearCloseIconButton" TargetType="Button" BasedOn="{StaticResource LinearIconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CloseBgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource CloseFgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CloseBgPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost (text) button — flat, hover steps up. -->
    <Style x:Key="LinearGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontWeight" Value="600"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusStd}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented item (single RadioButton in a group). Sits in a
         container Border that provides the 1px outline + 2px inner
         padding. Selected item gets the light-indigo selection
         background (SelectionBg) + darker indigo foreground
         (SelectionFg) — matching the main app's selection style. -->
    <Style x:Key="LinearSegmentedItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="600"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource SelectionFg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 8×8 status dot, mirrors LinearDot from the main project's
         Tag.xaml. Color set in code-behind. -->
    <Style x:Key="LinearDot" TargetType="Border">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{StaticResource TextTertiary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>