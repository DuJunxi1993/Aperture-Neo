<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ApertureNeo.Plugins.Ocr</RootNamespace>
    <AssemblyName>ApertureNeo.Plugins.Ocr</AssemblyName>
    <GenerateRequiresPreviewFeaturesAttribute>false</GenerateRequiresPreviewFeaturesAttribute>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!-- After the Ocr.Core extraction (commit 1), this project's job is
       just the plugin shell + WPF window. The OCR engine (RapidOCR +
       OpenCV + ONNX runtime) lives in Plugins.Ocr.Core and its native
       deps + ONNX model files are transitively copied into this
       project's $(OutDir) via the ProjectReference, so DeployToMain
       still ships the right payload to bin/Plugins/. -->
  <Target Name="DeployToMain" AfterTargets="Build">
    <PropertyGroup>
      <MainPluginDir>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0-windows\Plugins\</MainPluginDir>
      <OpenCvRuntimeDir>$(NuGetPackageRoot)opencvsharp4.runtime.win\4.13.0.20260528\runtimes\win-x64\native\</OpenCvRuntimeDir>
      <RapidOcrRuntime>$(NuGetPackageRoot)rapidocrsharponnx\1.2.2\lib\net10.0\RapidOCRSharpOnnx.dll</RapidOcrRuntime>
      <OpenCvSharpRuntime>$(NuGetPackageRoot)opencvsharp4\4.13.0.20260528\lib\net8.0\OpenCvSharp.dll</OpenCvSharpRuntime>
      <OnnxRuntimeManaged>$(NuGetPackageRoot)microsoft.ml.onnxruntime.managed\1.26.0\lib\netstandard2.0\Microsoft.ML.OnnxRuntime.dll</OnnxRuntimeManaged>
      <SkiaSharpDir>$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.4\runtimes\win-x64\native\</SkiaSharpDir>
    </PropertyGroup>
    <ItemGroup>
      <_DeployFiles Include="$(OutDir)**\*.*"/>
    </ItemGroup>
    <Copy SourceFiles="@(_DeployFiles)"
          DestinationFiles="@(_DeployFiles->'$(MainPluginDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"/>
    <ItemGroup>
      <_OpenCvNative Include="$(OpenCvRuntimeDir)*.dll"/>
    </ItemGroup>
    <Copy SourceFiles="@(_OpenCvNative)"
          DestinationFolder="$(MainPluginDir)"
          SkipUnchangedFiles="true"/>
    <ItemGroup>
      <_ManagedRuntime Include="$(RapidOcrRuntime);$(OpenCvSharpRuntime);$(OnnxRuntimeManaged);$(NuGetPackageRoot)clipper2\2.0.0\lib\netstandard2.0\Clipper2Lib.dll;$(NuGetPackageRoot)system.numerics.tensors\8.0.0\lib\net8.0\System.Numerics.Tensors.dll"/>
    </ItemGroup>
    <Copy SourceFiles="@(_ManagedRuntime)"
          DestinationFolder="$(MainPluginDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')"/>
    <ItemGroup>
      <_SkiaSharpManaged Include="$(NuGetPackageRoot)skiasharp\3.119.4\lib\net10.0-windows10.0.19041\SkiaSharp.dll"/>
      <_SkiaSharpNative Include="$(SkiaSharpDir)*.dll"/>
      <_WinRtRuntime Include="$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.26100.57\lib\net8.0\WinRT.Runtime.dll"/>
    </ItemGroup>
    <Copy SourceFiles="@(_SkiaSharpManaged)"
          DestinationFolder="$(MainPluginDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')"/>
    <Copy SourceFiles="@(_SkiaSharpNative)"
          DestinationFolder="$(MainPluginDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')"/>
    <Copy SourceFiles="@(_WinRtRuntime)"
          DestinationFolder="$(MainPluginDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')"/>
    <Message Text="Deployed $(AssemblyName) -> $(MainPluginDir) (with Ocr.Core + OpenCV + managed + SkiaSharp + WinRT runtimes)" Importance="high"/>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Plugins.Ocr.Core\ApertureNeo.Plugins.Ocr.Core.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\ApertureNeo.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Page Include="Ui\OcrResultWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>