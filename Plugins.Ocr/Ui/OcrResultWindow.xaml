<Window x:Class="ApertureNeo.Plugins.Ocr.Ui.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字提取"
        Width="560" Height="380"
        MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="True"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI, Segoe UI, Arial"
        Foreground="#FF1a1a1a">

    <Window.Resources>
        <!-- Linear design tokens (light mode snapshot of DesignTokens.xaml in
             the main project). Embedded here so the OCR plugin stays
             self-contained and doesn't depend on the host's resource
             dictionaries. Keep in sync if main project's DesignTokens
             changes substantially. -->

        <FontFamily x:Key="FontPrimary">HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

        <CornerRadius x:Key="RadiusStd">4</CornerRadius>
        <CornerRadius x:Key="RadiusComfy">6</CornerRadius>
        <CornerRadius x:Key="RadiusCard">8</CornerRadius>
        <CornerRadius x:Key="RadiusPanel">12</CornerRadius>

        <SolidColorBrush x:Key="SurfaceCanvas"     Color="#FFfafafa"/>
        <SolidColorBrush x:Key="SurfacePanel"      Color="#FFf4f4f5"/>
        <SolidColorBrush x:Key="SurfaceElevated"   Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceCardHover"  Color="#FFF6F6F8"/>
        <SolidColorBrush x:Key="SurfaceHover"      Color="#FFE8E8EB"/>

        <SolidColorBrush x:Key="TextPrimary"   Color="#FF1a1a1a"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF4a4a52"/>
        <SolidColorBrush x:Key="TextTertiary"  Color="#FF8a8f98"/>
        <SolidColorBrush x:Key="TextQuat"      Color="#FFa8aab2"/>

        <SolidColorBrush x:Key="BrandPrimary"  Color="#FF5e6ad2"/>
        <SolidColorBrush x:Key="FocusRing"     Color="#FF5e6ad2"/>

        <SolidColorBrush x:Key="BorderSubtle"   Color="#12000000"/>
        <SolidColorBrush x:Key="BorderStandard" Color="#1F000000"/>
        <SolidColorBrush x:Key="BorderSolid"    Color="#FFE5E5E8"/>

        <SolidColorBrush x:Key="BtnBgGhost"  Color="#08000000"/>
        <SolidColorBrush x:Key="BtnBgHover"  Color="#14000000"/>
        <SolidColorBrush x:Key="BtnBgPress"  Color="#1F000000"/>

        <SolidColorBrush x:Key="StatusRed"   Color="#FFdc2626"/>
        <SolidColorBrush x:Key="StatusGreen" Color="#FF16a34a"/>

        <!-- Selection (matches main project's SelectionBg/SelectionFg — light
             indigo tint for selected segmented items). -->
        <SolidColorBrush x:Key="SelectionBg"   Color="#FFe0e1ff"/>
        <SolidColorBrush x:Key="SelectionFg"   Color="#FF3a4099"/>

        <!-- Close-button hover/press (matches main project's CloseBgHover/Press
             + the #ef4444 foreground used by LinearCloseButton). -->
        <SolidColorBrush x:Key="CloseBgHover" Color="#1AE81123"/>
        <SolidColorBrush x:Key="CloseBgPress" Color="#3CE81123"/>
        <SolidColorBrush x:Key="CloseFgHover" Color="#FFef4444"/>

        <!-- Card shadow: stronger opacity than the main project's ShadowDialog
             so the shadow is visible against any background. The shadow renders
             from a dedicated shadow-hosting Border inside the Window.Template,
             with a 12px margin giving the blur room to render. -->
        <DropShadowEffect x:Key="ShadowDialog" BlurRadius="24" ShadowDepth="0" Opacity="0.40" Color="Black"/>

        <!-- Linear focus visual: 2px indigo ring -->
        <Style x:Key="LinearFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" StrokeThickness="2"
                                   Stroke="{StaticResource FocusRing}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eyebrow label (11px / 510 / TextTertiary) -->
        <Style x:Key="LinearEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="510"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Value line (13px / 510 / TextPrimary) -->
        <Style x:Key="LinearValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="510"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Mono value (12px / 400 / TextSecondary) -->
        <Style x:Key="LinearMonoValue" TargetType="TextBlock" BasedOn="{StaticResource LinearValue}">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontWeight" Value="400"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <!-- 1px hairline divider -->
        <Style x:Key="LinearHairline" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Margin" Value="0,14,0,14"/>
        </Style>

        <!-- Flat icon button (28×28, mirrors LinearWindowButton from the
             main project). -->
        <Style x:Key="LinearIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgHover}"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary CTA (indigo). 28px tall, 6px corners, like
             LinearPrimaryButton. -->
        <Style x:Key="LinearPrimaryCta" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusStd}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF9aa6ff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF7170ff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close icon button (28x28, subtle red wash on hover/press) — the
             destructive variant of LinearIconButton, matching the main
             project's LinearCloseButton. The red wash + red glyph gives
             the user a clear hint that this action closes the window. -->
        <Style x:Key="LinearCloseIconButton" TargetType="Button" BasedOn="{StaticResource LinearIconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CloseBgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource CloseFgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CloseBgPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost (text) button — flat, hover steps up. -->
        <Style x:Key="LinearGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusStd}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BtnBgPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented item (single RadioButton in a group). Sits in a
             container Border that provides the 1px outline + 2px inner
             padding. Selected item gets the light-indigo selection
             background (SelectionBg) + darker indigo foreground
             (SelectionFg) — matching the main app's selection style. -->
        <Style x:Key="LinearSegmentedItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SelectionBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectionFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 8×8 status dot, mirrors LinearDot from the main project's
             Tag.xaml. Color set in code-behind. -->
        <Style x:Key="LinearDot" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{StaticResource TextTertiary}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <!-- Custom Window.Template: a single content Border with rounded
         corners, SurfaceCanvas background, and DropShadowEffect. The
         16px outer margin gives the 24px-blur shadow room to render
         within the window's bounds (without being clipped by the window
         edge). With WindowStyle=None + AllowsTransparency=True, the OS
         draws no chrome and WPF owns the entire visual, so the shadow
         renders against the desktop. -->
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Grid Margin="16">
                <Border CornerRadius="10"
                        Background="{StaticResource SurfaceCanvas}">
                    <Border.Effect>
                        <StaticResource ResourceKey="ShadowDialog"/>
                    </Border.Effect>
                    <ContentPresenter/>
                </Border>
            </Grid>
        </ControlTemplate>
    </Window.Template>

    <!-- Content body. The Border.ClipToBounds (default True) clips our
         3-row Grid to the rounded shape, restoring the rounded look that
         the previous attempt lost. -->
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 44px title bar: app label + file name (left), close button (right) -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceCanvas}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Margin="20,0,0,0">
                        <TextBlock Text="文字提取" FontSize="12" FontWeight="700"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderFileName" Text="" FontSize="12" FontWeight="400"
                                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,8,0"
                            Style="{StaticResource LinearCloseIconButton}" Click="BtnClose_Click"
                            ToolTip="关闭">
                        <TextBlock Text="×" FontSize="16" FontWeight="400"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body: status + toolbar + edit box. No separate "文件" section —
                 the file name now lives in the title bar. -->
            <Grid Grid.Row="1" Margin="32,20,32,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status row: dot + label + meta (lines · ms) -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="状态" Style="{StaticResource LinearEyebrow}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot" Style="{StaticResource LinearDot}"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource LinearValue}"/>
                        <TextBlock x:Name="MetaText" Style="{StaticResource LinearMonoValue}" Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Formatting toolbar: 换行/不换行 + 有空格/清除空格 (both segmented) -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="排版" Style="{StaticResource LinearEyebrow}"
                                   VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <Border BorderBrush="{StaticResource BorderStandard}" BorderThickness="1"
                                CornerRadius="6" Background="{StaticResource SurfacePanel}" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioWrap" GroupName="LayoutMode"
                                             Style="{StaticResource LinearSegmentedItem}"
                                             IsChecked="True"
                                             Checked="RadioWrap_Checked" Content="换行"/>
                                <RadioButton x:Name="RadioNoWrap" GroupName="LayoutMode"
                                             Style="{StaticResource LinearSegmentedItem}"
                                             Checked="RadioNoWrap_Checked" Content="不换行"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="空格" Style="{StaticResource LinearEyebrow}"
                                   VerticalAlignment="Center" Margin="14,0,10,6"/>
                        <Border BorderBrush="{StaticResource BorderStandard}" BorderThickness="1"
                                CornerRadius="6" Background="{StaticResource SurfacePanel}" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioWithSpaces" GroupName="SpaceMode"
                                             Style="{StaticResource LinearSegmentedItem}"
                                             IsChecked="True"
                                             Checked="RadioWithSpaces_Checked" Content="有空格"/>
                                <RadioButton x:Name="RadioClearSpaces" GroupName="SpaceMode"
                                             Style="{StaticResource LinearSegmentedItem}"
                                             Checked="RadioClearSpaces_Checked" Content="清除空格"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Result box (the actual OCR text, editable). TextWrapping is
                     always Wrap: in 换行 mode each \n starts a new line; in
                     不换行 mode the text is one long line and the TextBox
                     wraps it at the window edge. -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderStandard}" BorderThickness="1"
                        Background="{StaticResource SurfaceElevated}" CornerRadius="{StaticResource RadiusCard}"
                        Margin="0,10,0,0">
                    <ScrollViewer Padding="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBox x:Name="ResultBox"
                                 IsReadOnly="False"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="12,10"
                                 FontFamily="{StaticResource FontPrimary}"
                                 FontSize="13"
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextOptions.TextFormattingMode="Ideal"
                                 UseLayoutRounding="True"
                                 SpellCheck.IsEnabled="False"/>
                    </ScrollViewer>
                </Border>

                <!-- Error message + edit hint -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource StatusRed}"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="文本可直接编辑" Style="{StaticResource LinearEyebrow}"
                               Margin="0,0,2,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Bottom action bar: 1px hairline top, action buttons right -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceCanvas}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCopyAll" Style="{StaticResource LinearPrimaryCta}"
                            Content="复制全文" Click="BtnCopyAll_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource LinearGhostButton}"
                            Content="关闭" Click="BtnClose_Click" IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
</Window>
