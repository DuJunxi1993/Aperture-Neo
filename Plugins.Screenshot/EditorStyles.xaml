<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Self-contained color tokens. Mirrors the subset of
         DesignTokens.xaml that the editor uses. The editor lives
         in Plugins.Screenshot.dll which is loaded standalone by
         ScreenshotTool.exe (no App.xaml resource chain), so the
         tokens must be declared locally. Values match the main
         app's light-mode Linear palette for visual consistency. -->
    <SolidColorBrush x:Key="SurfaceCanvas"   Color="#FFfafafa"/>
    <SolidColorBrush x:Key="SurfacePanel"    Color="#FFf4f4f5"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceCardHover" Color="#FFF6F6F8"/>
    <SolidColorBrush x:Key="SurfaceHover"    Color="#FFE8E8EB"/>

    <SolidColorBrush x:Key="TextPrimary"   Color="#FF1a1a1a"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF4a4a52"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="#FF8a8f98"/>

    <SolidColorBrush x:Key="BrandPrimary"  Color="#FF5e6ad2"/>

    <SolidColorBrush x:Key="BorderSubtle"   Color="#12000000"/>
    <SolidColorBrush x:Key="BorderStandard" Color="#1F000000"/>
    <SolidColorBrush x:Key="BorderSolid"    Color="#FFE5E5E8"/>

    <SolidColorBrush x:Key="DestructiveFg"      Color="#FFb91c1c"/>
    <SolidColorBrush x:Key="DestructiveBgHover" Color="#2Efee2e2"/>

    <SolidColorBrush x:Key="SliderTrack"     Color="#1F000000"/>
    <SolidColorBrush x:Key="SliderTrackFill" Color="#FF5e6ad2"/>

    <!-- Border radius scale (Linear 4-8px rhythm) -->
    <CornerRadius x:Key="RadiusStd">4</CornerRadius>
    <CornerRadius x:Key="RadiusComfy">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>

    <!-- Font family. Falls back through the platform chain
         (Segoe UI on Windows is the system default sans-serif). -->
    <FontFamily x:Key="FontPrimary">Segoe UI, Microsoft YaHei UI, Arial</FontFamily>

    <!-- Focus visual: 2px solid brand ring with 2px offset, drawn
         only on keyboard focus (system IsKeyboardFocused state). -->
    <Style x:Key="LinearFocusVisual" TargetType="Control">
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="-2"
                                           StrokeThickness="2"
                                           Stroke="{StaticResource BrandPrimary}"
                                           SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Tool Button: small (28px) flat button with subtle
         background and brand-foreground text. Used for toolbar
         actions like Clear, Fit, 100%, -, +, Save, Copy, OCR.
         Hover steps the background up one tier; press another. -->
    <Style x:Key="LinearToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="500"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusStd}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#14000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1F000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Primary Button: filled indigo. Used for Done. -->
    <Style x:Key="LinearPrimaryButton" TargetType="Button" BasedOn="{StaticResource LinearToolButton}">
        <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="600"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusStd}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF9aa6ff"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF7170ff"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Destructive Button: subtle red text, red-tinted hover.
         Used for Cancel. The button stays text-only at rest (matching
         Linear's destructive-button pattern) and reveals intent on
         hover with a pale red wash. -->
    <Style x:Key="LinearDestructiveButton" TargetType="Button" BasedOn="{StaticResource LinearToolButton}">
        <Setter Property="Foreground" Value="{StaticResource DestructiveFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusStd}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DestructiveBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#60fee2e2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Tool Toggle: same as LinearToolButton but with an
         additional Checked state that fills the background with
         the brand-tinted selection color and bolds the foreground.
         Used for the Pen mode toggle. -->
    <Style x:Key="LinearToolToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="500"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusStd}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#14000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1F000000"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFe0e1ff"/>
                            <Setter Property="Foreground" Value="#FF3a4099"/>
                            <Setter Property="FontWeight" Value="600"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Pen Size Toggle: same shape as LinearToolToggle but
         smaller (22x22 square) and content-positioned for a number
         label. Used for the inline 2/4/8/12/20 pen-size selector. -->
    <Style x:Key="LinearPenSizeToggle" TargetType="ToggleButton" BasedOn="{StaticResource LinearToolToggle}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Linear Color Circle: 22×22 circle that fills with the
         ToggleButton's Tag color (a hex string). Used for the
         pen color picker. When checked, the circle gets a 2px
         brand-indigo ring to indicate the selected color. The
         "Tag" binding pattern is the standard WPF way to carry
         per-instance data through a shared style. -->
    <Style x:Key="LinearColorCircle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Ellipse x:Name="ring"
                                 Width="22" Height="22"
                                 Stroke="Transparent"
                                 StrokeThickness="2"
                                 Fill="Transparent"/>
                        <Ellipse x:Name="dot"
                                 Width="16" Height="16"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{TemplateBinding Tag}"
                                 Stroke="{StaticResource BorderStandard}"
                                 StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="#40000000"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource BrandPrimary}"/>
                            <Setter TargetName="ring" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Slider: 4px track (semi-transparent black on light),
         14px circular thumb with brand color when active. No tick
         marks (clean Linear look). Increase/Decrease buttons are
         hidden — use the +/- buttons next to the slider for that. -->
    <Style x:Key="LinearSlider" TargetType="Slider">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="TrackBackground"
                                Height="4"
                                Background="{StaticResource SliderTrack}"
                                CornerRadius="2"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" Height="4">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{StaticResource SliderTrackFill}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="14" Height="14"
                                                     Fill="White"
                                                     Stroke="{StaticResource BorderStandard}"
                                                     StrokeThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Color Swatch: a 22x22 square used inside the
         ComboBox popup. The ComboBox itself just shows a single
         swatch + a small chevron. -->
    <Style x:Key="LinearColorSwatch" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStandard}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Linear ComboBox: minimal — flat background, subtle hover,
         a single 8x4 chevron rendered manually. The full template
         is large; the styles below cover the visible parts. -->
    <Style x:Key="LinearComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStandard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearFocusVisual}"/>
    </Style>

    <!-- Linear ToolBar Separator: 1px vertical line in BorderStandard.
         Used between toolbar groups instead of the WPF default
         (which is a dark gradient that doesn't match the theme). -->
    <Style x:Key="LinearToolbarSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="Fill" Value="{StaticResource BorderStandard}"/>
    </Style>

    <!-- Linear Subtle Label: 12px, weight 510, tertiary text color.
         Used for "Color:", "Size:" labels next to controls. -->
    <Style x:Key="LinearSubtleLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="500"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
