<Window x:Class="ApertureNeo.Plugins.Screenshot.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ApertureNeo.Controls;assembly=ApertureNeo"
        Title="" Width="960" Height="700"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- P5: chrome-less window matching the main app's title
         bar. CaptionHeight=44 keeps a non-zero drag region (a
         zero caption would disable WindowChrome drag), and
         UseAeroCaptionButtons=False hides the system min/max/
         close glyphs (we don't render our own in the editor —
         Cancel in the top bar is the only close-style action). -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApertureNeo;component/DesignTokens.xaml"/>
                <ResourceDictionary Source="/ApertureNeo;component/Styles/Annotation.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top bar (formerly the title bar / pen
                     column). Pen toggle, color picker, size picker,
                     Clear / Undo, then Save / Cancel on the right.
                     Same Linear tokens as the rest of the app. -->
                <RowDefinition Height="Auto"/>
                <!-- Viewer + pen-canvas overlay area. -->
                <RowDefinition Height="*"/>
                <!-- Bottom bar: status text on the left, zoom
                     controls centered, Copy / OCR / Done anchored
                     to the right. As the window shrinks, the
                     status text compresses first (TextTrimming),
                     the zoom slider narrows, and the Copy / OCR /
                     Done cluster stays at content width. -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: top bar (Linear style, replaces the title
                 bar). Background = SurfacePanel (same as the main
                 app's title bar); 1px hairline at the bottom. -->
            <Border Grid.Row="0"
                    Background="#FFf4f4f5"
                    BorderBrush="#12000000"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pen mode toggle (left). -->
                    <ToggleButton Grid.Column="0" x:Name="PenToggle" Content="Pen"
                                  Style="{StaticResource LinearToolToggle}"
                                  IsChecked="True"
                                  Click="PenToggle_Click"/>

                    <!-- Drawing tools: color picker + size picker
                         + Clear / Undo (center, fill the space
                         between Pen and Save/Cancel). -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Margin="16,0,16,0">
                        <TextBlock Text="颜色" Style="{StaticResource LinearSubtleLabel}" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <RadioButton x:Name="ColorRedBtn" Width="22" Height="22" Margin="0,0,4,0"
                                      GroupName="PenColor" IsChecked="True"
                                      Tag="#FFE11D48"
                                      Click="ColorBtn_Click"
                                      Style="{StaticResource LinearColorCircle}"/>
                        <RadioButton x:Name="ColorOrangeBtn" Width="22" Height="22" Margin="0,0,4,0"
                                      GroupName="PenColor"
                                      Tag="#FFEA580C"
                                      Click="ColorBtn_Click"
                                      Style="{StaticResource LinearColorCircle}"/>
                        <RadioButton x:Name="ColorYellowBtn" Width="22" Height="22" Margin="0,0,4,0"
                                      GroupName="PenColor"
                                      Tag="#FFEAB308"
                                      Click="ColorBtn_Click"
                                      Style="{StaticResource LinearColorCircle}"/>
                        <RadioButton x:Name="ColorGreenBtn" Width="22" Height="22" Margin="0,0,4,0"
                                      GroupName="PenColor"
                                      Tag="#FF16A34A"
                                      Click="ColorBtn_Click"
                                      Style="{StaticResource LinearColorCircle}"/>
                        <RadioButton x:Name="ColorBlueBtn" Width="22" Height="22" Margin="0,0,4,0"
                                      GroupName="PenColor"
                                      Tag="#FF2563EB"
                                      Click="ColorBtn_Click"
                                      Style="{DynamicResource LinearColorCircle}"/>
                        <RadioButton x:Name="ColorBlackBtn" Width="22" Height="22"
                                      GroupName="PenColor"
                                      Tag="#FF1a1a1a"
                                      Click="ColorBtn_Click"
                                      Style="{DynamicResource LinearColorCircle}"/>
                        <RadioButton x:Name="ColorWhiteBtn" Width="22" Height="22" Margin="4,0,0,0"
                                      GroupName="PenColor"
                                      Tag="#FFFFFFFF"
                                      Click="ColorBtn_Click"
                                      Style="{DynamicResource LinearColorCircle}"/>

                        <Rectangle Style="{DynamicResource LinearToolbarSeparator}"/>

                        <TextBlock Text="粗细" Style="{StaticResource LinearSubtleLabel}" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <RadioButton x:Name="Size2Btn" Content="2" GroupName="PenSize"
                                      Style="{DynamicResource LinearPenSizeToggle}"
                                      Click="SizeBtn_Click"/>
                        <RadioButton x:Name="Size4Btn" Content="4" GroupName="PenSize" IsChecked="True"
                                      Style="{DynamicResource LinearPenSizeToggle}"
                                      Margin="3,0,0,0" Click="SizeBtn_Click"/>
                        <RadioButton x:Name="Size8Btn" Content="8" GroupName="PenSize"
                                      Style="{DynamicResource LinearPenSizeToggle}"
                                      Margin="3,0,0,0" Click="SizeBtn_Click"/>
                        <RadioButton x:Name="Size12Btn" Content="12" GroupName="PenSize"
                                      Style="{DynamicResource LinearPenSizeToggle}"
                                      Margin="3,0,0,0" Click="SizeBtn_Click"/>
                        <RadioButton x:Name="Size20Btn" Content="20" GroupName="PenSize"
                                      Style="{DynamicResource LinearPenSizeToggle}"
                                      Margin="3,0,0,0" Click="SizeBtn_Click"/>

                        <Rectangle Style="{DynamicResource LinearToolbarSeparator}"/>

                        <Button Content="清空" Style="{DynamicResource LinearToolButton}"
                                Click="Clear_Click"/>
                        <Button Content="撤销" Style="{DynamicResource LinearToolButton}"
                                Margin="6,0,0,0" Click="Undo_Click"/>
                    </StackPanel>

                    <!-- Save + Cancel (right). -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="保存" Style="{DynamicResource LinearPrimaryButton}"
                                Click="Save_Click"/>
                        <Button Content="取消" Style="{DynamicResource LinearDestructiveButton}"
                                Margin="6,0,0,0" Click="Cancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: viewer + pen-canvas overlay. -->
            <Grid Grid.Row="1" Background="#FFfafafa" ClipToBounds="True">
                <controls:SkiaImageViewer x:Name="SkiaViewer"/>
                <Canvas x:Name="PenCanvas" Background="Transparent"
                        IsHitTestVisible="{Binding IsChecked, ElementName=PenToggle}"
                        MouseLeftButtonDown="PenCanvas_MouseLeftButtonDown"
                        MouseMove="PenCanvas_MouseMove"
                        MouseLeftButtonUp="PenCanvas_MouseLeftButtonUp"
                        MouseWheel="PenCanvas_MouseWheel"/>
            </Grid>

            <!-- Row 2: bottom bar. Status text (left, auto-sized by
                 content, clips to ellipsis when window shrinks) |
                 zoom controls (Fill, centered) | Copy / OCR / Done
                 (right, fixed at content width). Copy / OCR / Done
                 always visible — that's the priority. -->
            <Border Grid.Row="2"
                    Background="#FFf4f4f5"
                    BorderBrush="#12000000"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Status: 0.3* so it gets less space than
                             zoom, compressing first when the parent
                             shrinks. MinWidth=0 + TextTrimming means
                             the text collapses to ellipsis before
                             anything else is forced smaller. -->
                        <ColumnDefinition Width="0.3*" MinWidth="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="StatusText"
                               Text="Ready"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="FitBtn" Content="Fit"
                                Style="{DynamicResource LinearToolButton}"
                                Click="FitBtn_Click"/>
                        <Slider x:Name="ZoomSlider" Width="180"
                                Style="{DynamicResource LinearSlider}"
                                Minimum="0.5" Maximum="2" Value="1.0"
                                Margin="12,0,8,0"
                                ValueChanged="ZoomSlider_ValueChanged"/>
                        <TextBlock x:Name="ZoomLabel" Text="100%"
                                   Style="{StaticResource LinearSubtleLabel}"
                                   Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#FF1a1a1a"/>
                        <Button x:Name="ZoomOutBtn" Content="−"
                                Style="{DynamicResource LinearToolButton}"
                                Width="28" Margin="0,0,0,0" FontSize="14"
                                Click="ZoomOutBtn_Click"/>
                        <Button x:Name="ZoomInBtn" Content="+"
                                Style="{DynamicResource LinearToolButton}"
                                Width="28" Margin="4,0,0,0" FontSize="14"
                                Click="ZoomInBtn_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="CopyBtn" Content="Copy"
                                Style="{DynamicResource LinearToolButton}"
                                Click="Copy_Click"/>
                        <Button x:Name="OcrBtn" Content="OCR"
                                Style="{DynamicResource LinearToolButton}"
                                Margin="6,0,0,0"
                                Click="Ocr_Click"/>
                        <Button x:Name="OkBtn" Content="Done"
                                Style="{DynamicResource LinearPrimaryButton}"
                                Margin="6,0,0,0"
                                Click="Ok_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
