<Window x:Class="ApertureNeo.Plugins.Screenshot.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Editor" Width="960" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" Background="#2D2D2D">
            <ToolBar Band="1" Background="Transparent">
                <ToggleButton x:Name="PenToggle" Content="Pen" IsChecked="True" Click="PenToggle_Click"/>
                <Button x:Name="ClearBtn" Content="Clear" Click="Clear_Click"/>
                <Separator/>
                <Label Content="Color:" Foreground="#CCC" VerticalAlignment="Center"/>
                <ComboBox x:Name="ColorPicker" SelectedIndex="0" Width="80" VerticalAlignment="Center">
                    <ComboBoxItem Foreground="Red">Red</ComboBoxItem>
                    <ComboBoxItem Foreground="#00FF00">Green</ComboBoxItem>
                    <ComboBoxItem Foreground="Blue">Blue</ComboBoxItem>
                    <ComboBoxItem Foreground="Yellow">Yellow</ComboBoxItem>
                    <ComboBoxItem Foreground="White">White</ComboBoxItem>
                    <ComboBoxItem Foreground="Black">Black</ComboBoxItem>
                </ComboBox>
                <Label Content="Size:" Foreground="#CCC" VerticalAlignment="Center"/>
                <Slider x:Name="SizeSlider" Minimum="2" Maximum="20" Value="4" Width="80"
                        VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True"/>
            </ToolBar>
            <ToolBar Band="2" Background="Transparent" HorizontalAlignment="Right">
                <Button x:Name="SaveBtn" Content="Save" Click="Save_Click"/>
                <Button x:Name="CopyBtn" Content="Copy" Click="Copy_Click"/>
                <Button x:Name="OcrBtn" Content="OCR" Click="Ocr_Click"/>
                <Separator/>
                <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Content="Done" Click="Ok_Click" FontWeight="Bold"/>
            </ToolBar>
        </ToolBarTray>

        <Grid Background="#1E1E1E" ClipToBounds="True">
            <Image x:Name="ViewportImage" Stretch="Uniform"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"/>
            <Canvas x:Name="ViewportCanvas" Background="Transparent"
                    MouseLeftButtonDown="Canvas_MouseDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseUp"/>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom" Background="#2D2D2D" Height="24">
            <StatusBarItem x:Name="StatusText" Content="Ready" Foreground="#AAA"/>
        </StatusBar>
    </DockPanel>
</Window>
