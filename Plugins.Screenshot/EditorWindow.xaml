<Window x:Class="ApertureNeo.Plugins.Screenshot.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ApertureNeo.Controls;assembly=ApertureNeo"
        xmlns:annot="clr-namespace:ApertureNeo.Controls.Annotation;assembly=ApertureNeo"
        Title="Screenshot Editor" Width="960" Height="700"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- P5: load the shared Linear tokens + annotation
                     styles from the main app assembly via pack URI. -->
                <ResourceDictionary Source="/ApertureNeo;component/DesignTokens.xaml"/>
                <ResourceDictionary Source="/ApertureNeo;component/Styles/Annotation.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- P5: shared drawing toolbar (Clear / Undo /
                 Color / Size / Save) reuses the same control
                 the main app's annotation mode uses. -->
            <RowDefinition Height="Auto"/>
            <!-- Editor-specific secondary toolbar: Pen mode
                 toggle, zoom controls, output actions (Copy /
                 OCR / Cancel / Done). -->
            <RowDefinition Height="Auto"/>
            <!-- Viewer + pen-canvas overlay area. -->
            <RowDefinition Height="*"/>
            <!-- Status bar. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: shared annotation toolbar. State is wired
             from code-behind (Window_Loaded) since the editor
             owns the AnnotationState instance. SaveRequested
             routes to the editor's save handler. -->
        <annot:AnnotationOverlay x:Name="AnnotationBar" Grid.Row="0"
                                 SaveRequested="AnnotationBar_SaveRequested"/>

        <!-- Row 1: editor-specific secondary toolbar. SurfacePanel
             (same as before) with a 1px hairline above. -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfacePanel}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,1"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pen mode toggle (left). The PenCanvas.IsHitTestVisible
                     is bound to IsChecked so the canvas only catches
                     mouse events in pen mode. -->
                <ToggleButton Grid.Column="0" x:Name="PenToggle" Content="Pen"
                              Style="{StaticResource LinearToolToggle}"
                              IsChecked="True"
                              Click="PenToggle_Click"/>

                <!-- Zoom controls (center). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="FitBtn" Content="Fit"
                            Style="{StaticResource LinearToolButton}"
                            Click="FitBtn_Click"/>
                    <Slider x:Name="ZoomSlider" Width="180"
                            Style="{StaticResource LinearSlider}"
                            Minimum="0.5" Maximum="2" Value="1.0"
                            Margin="12,0,8,0"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%"
                               Style="{StaticResource LinearSubtleLabel}"
                               Width="44" TextAlignment="Right"
                               Foreground="{StaticResource TextPrimary}"/>
                    <Button x:Name="ZoomOutBtn" Content="−"
                            Style="{StaticResource LinearToolButton}"
                            Width="28" Margin="8,0,0,0" FontSize="14"
                            Click="ZoomOutBtn_Click"/>
                    <Button x:Name="ZoomInBtn" Content="+"
                            Style="{StaticResource LinearToolButton}"
                            Width="28" Margin="4,0,0,0" FontSize="14"
                            Click="ZoomInBtn_Click"/>
                </StackPanel>

                <!-- Output actions (right). -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CopyBtn" Content="Copy"
                            Style="{StaticResource LinearToolButton}"
                            Click="Copy_Click"/>
                    <Button x:Name="OcrBtn" Content="OCR"
                            Style="{StaticResource LinearToolButton}"
                            Margin="6,0,0,0"
                            Click="Ocr_Click"/>
                    <Rectangle Style="{StaticResource LinearToolbarSeparator}"/>
                    <Button x:Name="CancelBtn" Content="Cancel"
                            Style="{StaticResource LinearDestructiveButton}"
                            Click="Cancel_Click"/>
                    <Button x:Name="OkBtn" Content="Done"
                            Style="{StaticResource LinearPrimaryButton}"
                            Margin="6,0,0,0"
                            Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main canvas area: SkiaImageViewer for the source
             image + a transparent Canvas overlay for pen strokes. -->
        <Grid Grid.Row="2" Background="{StaticResource SurfaceCanvas}" ClipToBounds="True">
            <controls:SkiaImageViewer x:Name="SkiaViewer"/>
            <Canvas x:Name="PenCanvas" Background="Transparent"
                    IsHitTestVisible="{Binding IsChecked, ElementName=PenToggle}"
                    MouseLeftButtonDown="PenCanvas_MouseLeftButtonDown"
                    MouseMove="PenCanvas_MouseMove"
                    MouseLeftButtonUp="PenCanvas_MouseLeftButtonUp"
                    MouseWheel="PenCanvas_MouseWheel"/>
        </Grid>

        <!-- Status bar. -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfacePanel}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="16,5">
            <TextBlock x:Name="StatusText" Text="Ready"
                       FontFamily="{StaticResource FontPrimary}"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiary}"/>
        </Border>
    </Grid>
</Window>
