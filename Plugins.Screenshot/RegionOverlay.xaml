<Window x:Class="ApertureNeo.Plugins.Screenshot.RegionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="True">
            <Rectangle x:Name="DimTop" Fill="#80000000"/>
            <Rectangle x:Name="DimBottom" Fill="#80000000"/>
            <Rectangle x:Name="DimLeft" Fill="#80000000"/>
            <Rectangle x:Name="DimRight" Fill="#80000000"/>
            <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="2"
                       StrokeDashArray="4,2" Fill="Transparent" Visibility="Collapsed"/>
        </Canvas>
        <Border Background="#DD1E1E1E" CornerRadius="6" Padding="8,5"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ActionBarText" Text="Drag to select area" Foreground="White"
                           VerticalAlignment="Center" Margin="6,0,8,0" FontSize="12"/>
                <Button x:Name="ConfirmBtn" Content="Confirm" Padding="12,4" Margin="2,0"
                        IsEnabled="False" Click="ConfirmBtn_Click"/>
                <Button x:Name="RecaptureBtn" Content="Recapture" Padding="12,4" Margin="2,0"
                        Click="RecaptureBtn_Click"/>
                <Button x:Name="CancelBtn" Content="Cancel" Padding="12,4" Margin="2,0"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
