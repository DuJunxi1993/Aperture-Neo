<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Linear styles for the annotation toolbar (used by both the
         screenshot editor and the main app's annotation mode).

         Colour tokens come from ApertureNeo's DesignTokens.xaml
         (loaded as a sibling MergedDictionary by the host). All
         references here are {StaticResource Xxx} so the host
         resolves them at parse time. The dictionary is self-
         contained otherwise — adding it to a MergedDictionaries
         list brings in every annotation control style below.

         This file is the source of truth for the annotation UI's
         look; the previous Plugins.Screenshot/EditorStyles.xaml
         is gone (deleted when the editor migrated to ApertureNeo
         controls). The editor now loads these styles via
         <ResourceDictionary Source="/ApertureNeo;component/Styles/Annotation.xaml"/>
         so the standalone ScreenshotTool.exe and the main app
         use the same style definitions. -->

    <!-- Focus visual: 2px solid brand ring, drawn just outside
         the control's bounds. Drawn only on keyboard focus
         (IsKeyboardFocused). -->
    <Style x:Key="LinearAnnotationFocusVisual" TargetType="Control">
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Rectangle Margin="-2"
                                           StrokeThickness="2"
                                           Stroke="{StaticResource BrandPrimary}"
                                           SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Tool Button: 28px flat button with subtle
         background, used in the annotation toolbar for Clear,
         Undo, Save. Hover/press step the background up one tier
         on the surface ladder. -->
    <Style x:Key="LinearToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="500"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearAnnotationFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#14000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1F000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Primary Button: filled indigo. Used for the
         annotation toolbar's Save action. -->
    <Style x:Key="LinearPrimaryButton" TargetType="Button" BasedOn="{StaticResource LinearToolButton}">
        <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="600"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF9aa6ff"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF7170ff"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Destructive Button: subtle red text, red-tinted
         hover. Used for the SaveDialog's "覆盖原图" action. -->
    <Style x:Key="LinearDestructiveButton" TargetType="Button" BasedOn="{StaticResource LinearToolButton}">
        <Setter Property="Foreground" Value="{StaticResource DestructiveFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DestructiveBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#60fee2e2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Tool Toggle: same shape as LinearToolButton but
         with an IsChecked visual (brand-tinted background, deeper
         foreground, semibold weight). Used as the base for the
         pen-mode toggle in the editor and the size selector
         (both styles below are ToggleButton-derived and need
         this TargetType for a valid BasedOn chain). -->
    <Style x:Key="LinearToolToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="500"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearAnnotationFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={StaticResource TextPrimary}}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#14000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1F000000"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFe0e1ff"/>
                            <Setter Property="Foreground" Value="#FF3a4099"/>
                            <Setter Property="FontWeight" Value="600"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Pen Size Toggle: small (26x26) toggle button. Used
         for the 2/4/8/12/20 pen size selector in the toolbar.
         BasedOn LinearToolToggle (not LinearToolButton) because
         the style is applied to RadioButton (which is a
         ToggleButton subclass, not a Button). WPF rejects a
         based-on chain whose TargetType is not a base of the
         consumer's type. -->
    <Style x:Key="LinearPenSizeToggle" TargetType="ToggleButton" BasedOn="{StaticResource LinearToolToggle}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Linear Color Circle: 22x22 circle filled with the
         ToggleButton's Tag color. Used for the pen color
         picker. When checked, the circle gets a 2px brand ring.
         Tag must be a hex string like "#FFE11D48"; the Binding
         (not TemplateBinding) runs the BrushConverter that turns
         the string into a SolidColorBrush. -->
    <Style x:Key="LinearColorCircle" TargetType="RadioButton">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearAnnotationFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Ellipse x:Name="ring"
                                 Width="22" Height="22"
                                 Stroke="Transparent"
                                 StrokeThickness="2"
                                 Fill="Transparent"/>
                        <Ellipse x:Name="dot"
                                 Width="16" Height="16"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                 Stroke="{StaticResource BorderStandard}"
                                 StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="#40000000"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="{StaticResource BrandPrimary}"/>
                            <Setter TargetName="ring" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Slider: 4px track, 14px circular thumb, no ticks.
         Used for the zoom slider in the annotation toolbar. -->
    <Style x:Key="LinearSlider" TargetType="Slider">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LinearAnnotationFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="TrackBackground"
                                Height="4"
                                Background="{StaticResource SliderTrack}"
                                CornerRadius="2"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" Height="4">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{StaticResource SliderTrackFill}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="14" Height="14"
                                                     Fill="White"
                                                     Stroke="{StaticResource BorderStandard}"
                                                     StrokeThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Linear Annotation Toolbar Separator: 1px vertical line
         in BorderStandard. Used between toolbar groups. -->
    <Style x:Key="LinearToolbarSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="Fill" Value="{StaticResource BorderStandard}"/>
    </Style>

    <!-- Linear Subtle Label: 12px weight 500 secondary text. -->
    <Style x:Key="LinearSubtleLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="500"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Implicit text settings for the annotation toolbar. The
         comment on the App.xaml TextBlock style explains why
         FontFamily is set imperatively instead of via Window
         (the Window-level Foreground would beat the per-button
         Foreground set by LinearPrimaryButton). We replicate
         just the font and TextOptions on the toolbar so child
         controls inherit consistent defaults. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

</ResourceDictionary>
