<Window x:Class="ApertureNeo.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ApertureNeo.Controls"
        Title="Image Editor" Width="960" Height="700"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApertureNeo;component/DesignTokens.xaml"/>
                <ResourceDictionary Source="/ApertureNeo;component/Styles/Annotation.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--
    Custom Window.Template (Phase 0): the OCR window's approach
    (Plugins.Ocr.Ui/OcrResultWindow.xaml) is reused here. A
    WindowChrome would also work, but using a ControlTemplate
    gives us full control over the visual tree (the rounded
    Border + DropShadowEffect) and avoids the chrome-event
    interception that made toolbar buttons unclickable.
    WindowStyle=None + AllowsTransparency=True + Background=
    Transparent make WPF render the entire visual tree as a
    single layered bitmap; the Border's CornerRadius=8 then
    determines the visible window shape. The 16/16/16/32 margin
    leaves room for the 24px-blur + 8px-depth shadow to render
    without being clipped at the window edge; the asymmetric
    bottom accounts for ShadowDepth=8 (8px down). -->
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Grid>
                <Grid x:Name="ContentGrid" Margin="16,16,16,32">
                    <Border x:Name="ShadowBorder" CornerRadius="8"
                            Background="{StaticResource SurfaceCanvas}"
                            BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.18" Color="Black"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>

                    <!-- Invisible resize handles (4px edge strips,
                         8px corners) aligned to the visible Border -->
                    <Rectangle Height="4" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                              Cursor="SizeNS" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeTop_Click"/>
                    <Rectangle Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                              Cursor="SizeNS" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeBottom_Click"/>
                    <Rectangle Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                              Cursor="SizeWE" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeLeft_Click"/>
                    <Rectangle Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              Cursor="SizeWE" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeRight_Click"/>
                    <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Cursor="SizeNWSE" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeTopLeft_Click"/>
                    <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Cursor="SizeNESW" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeTopRight_Click"/>
                    <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Cursor="SizeNESW" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeBottomLeft_Click"/>
                    <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Cursor="SizeNWSE" Fill="Transparent"
                              PreviewMouseLeftButtonDown="ResizeBottomRight_Click"/>
                </Grid>
            </Grid>
        </ControlTemplate>
    </Window.Template>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title bar (44px, matches main app's TitleBarView
                 and the OCR window's title bar). Top-left:
                 "截图编辑-{filename}". Top-right: minimize /
                 maximize / close. CornerRadius rounds only the
                 TOP corners (8,8,0,0) so the opaque title-bar
                 background doesn't cover the outer Window.Template
                 Border's rounded top corners. The bottom corners
                 stay sharp so the title bar's bottom hairline meets
                 the toolbar cleanly. -->
            <RowDefinition Height="44"/>
            <!-- Existing toolbar (Phase 4: this used to be Row 0).
                 Cancel removed — the close button in the title bar
                 replaces it. Copy stays here, just left of Save. -->
            <RowDefinition Height="Auto"/>
            <!-- Viewer + pen-canvas overlay area. -->
            <RowDefinition Height="*"/>
            <!-- Bottom bar: status text (left) + zoom controls
                 (center) + OCR (right). -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: title bar. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCanvas}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: pen toggle + pen mode switch -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="PenToggle" Content="Pen"
                                  Style="{StaticResource LinearToolToggle}"
                                  IsChecked="True"
                                  Click="PenToggle_Click"/>
                    <Border Margin="6,0,0,0"
                            BorderBrush="#1F000000" BorderThickness="1"
                            CornerRadius="6"
                            Background="{StaticResource SurfacePanel}"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PenModeColor" GroupName="PenMode"
                                         Content="Color"
                                         Style="{StaticResource LinearSegmentedItem}"
                                         IsChecked="True"
                                         Checked="PenModeColor_Checked"/>
                            <RadioButton x:Name="PenModeMosaic" GroupName="PenMode"
                                         Content="Mosaic"
                                         Style="{StaticResource LinearSegmentedItem}"
                                         Checked="PenModeMosaic_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource LinearWindowButton}"
                            Click="MinimizeBtn_Click">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Data="M3.75391 12.5H20.2458C20.66 12.5 20.9958 12.1642 20.9958 11.75C20.9958 11.3358 20.66 11 20.2458 11H3.75391C3.33969 11 3.00391 11.3358 3.00391 11.75C3.00391 12.1642 3.33969 12.5 3.75391 12.5Z"
                              Fill="{StaticResource TextSecondary}"/>
                    </Button>
                    <Button Style="{StaticResource LinearWindowButton}"
                            Click="MaximizeBtn_Click">
                        <Path x:Name="MaximizeIcon" Width="12" Height="12"
                              Stretch="Uniform"
                              Data="M3 6.25C3 4.45507 4.45507 3 6.25 3H17.75C19.5449 3 21 4.45507 21 6.25V17.75C21 19.5449 19.5449 21 17.75 21H6.25C4.45507 21 3 19.5449 3 17.75V6.25ZM6.25 4.5C5.2835 4.5 4.5 5.2835 4.5 6.25V17.75C4.5 18.7165 5.2835 19.5 6.25 19.5H17.75C18.7165 19.5 19.5 18.7165 19.5 17.75V6.25C19.5 5.2835 18.7165 4.5 17.75 4.5H6.25Z"
                              Fill="{StaticResource TextSecondary}"/>
                    </Button>
                    <Button Style="{StaticResource LinearCloseButton}"
                            Click="CloseBtn_Click">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Data="M4.39705 4.55379L4.46967 4.46967C4.73594 4.2034 5.1526 4.1792 5.44621 4.39705L5.53033 4.46967L12 10.939L18.4697 4.46967C18.7626 4.17678 19.2374 4.17678 19.5303 4.46967C19.8232 4.76256 19.8232 5.23744 19.5303 5.53033L13.061 12L19.5303 18.4697C19.7966 18.7359 19.8208 19.1526 19.6029 19.4462L19.5303 19.5303C19.2641 19.7966 18.8474 19.8208 18.5538 19.6029L18.4697 19.5303L12 13.061L5.53033 19.5303C5.23744 19.8232 4.76256 19.8232 4.46967 19.5303C4.17678 19.2374 4.17678 18.7626 4.46967 18.4697L10.939 12L4.46967 5.53033C4.2034 5.26406 4.1792 4.8474 4.39705 4.55379L4.46967 4.46967L4.39705 4.55379Z"
                              Fill="{StaticResource TextSecondary}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: toolbar (was Row 0; Cancel removed). -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceCanvas}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Margin="16,0,16,0">
                    <TextBlock Text="颜色" Style="{StaticResource LinearSubtleLabel}" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <RadioButton x:Name="ColorRedBtn" Width="22" Height="22" Margin="0,0,4,0"
                                  GroupName="PenColor" IsChecked="True"
                                  Tag="#FFE11D48"
                                  Click="ColorBtn_Click"
                                  Style="{DynamicResource LinearColorCircle}"/>
                    <RadioButton x:Name="ColorOrangeBtn" Width="22" Height="22" Margin="0,0,4,0"
                                  GroupName="PenColor"
                                  Tag="#FFEA580C"
                                  Click="ColorBtn_Click"
                                  Style="{DynamicResource LinearColorCircle}"/>
                    <RadioButton x:Name="ColorYellowBtn" Width="22" Height="22" Margin="0,0,4,0"
                                  GroupName="PenColor"
                                  Tag="#FFEAB308"
                                  Click="ColorBtn_Click"
                                  Style="{DynamicResource LinearColorCircle}"/>
                    <RadioButton x:Name="ColorGreenBtn" Width="22" Height="22" Margin="0,0,4,0"
                                  GroupName="PenColor"
                                  Tag="#FF16A34A"
                                  Click="ColorBtn_Click"
                                  Style="{DynamicResource LinearColorCircle}"/>
                    <RadioButton x:Name="ColorBlueBtn" Width="22" Height="22" Margin="0,0,4,0"
                                  GroupName="PenColor"
                                  Tag="#FF2563EB"
                                  Click="ColorBtn_Click"
                                  Style="{DynamicResource LinearColorCircle}"/>
                    <RadioButton x:Name="ColorBlackBtn" Width="22" Height="22"
                                  GroupName="PenColor"
                                  Tag="#FF1a1a1a"
                                  Click="ColorBtn_Click"
                                  Style="{DynamicResource LinearColorCircle}"/>
                    <RadioButton x:Name="ColorWhiteBtn" Width="22" Height="22" Margin="4,0,0,0"
                                  GroupName="PenColor"
                                  Tag="#FFFFFFFF"
                                  Click="ColorBtn_Click"
                                  Style="{DynamicResource LinearColorCircle}"/>

                    <Rectangle Style="{DynamicResource LinearToolbarSeparator}"/>

                    <TextBlock Text="粗细" Style="{StaticResource LinearSubtleLabel}" Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <RadioButton x:Name="Size2Btn" Content="2" GroupName="PenSize"
                                  Style="{DynamicResource LinearPenSizeToggle}"
                                  Click="SizeBtn_Click"/>
                    <RadioButton x:Name="Size4Btn" Content="4" GroupName="PenSize"
                                  Style="{DynamicResource LinearPenSizeToggle}"
                                  Margin="3,0,0,0" Click="SizeBtn_Click"/>
                    <RadioButton x:Name="Size8Btn" Content="8" GroupName="PenSize" IsChecked="True"
                                  Style="{DynamicResource LinearPenSizeToggle}"
                                  Margin="3,0,0,0" Click="SizeBtn_Click"/>
                    <RadioButton x:Name="Size12Btn" Content="12" GroupName="PenSize"
                                  Style="{DynamicResource LinearPenSizeToggle}"
                                  Margin="3,0,0,0" Click="SizeBtn_Click"/>
                    <RadioButton x:Name="Size20Btn" Content="20" GroupName="PenSize"
                                  Style="{DynamicResource LinearPenSizeToggle}"
                                  Margin="3,0,0,0" Click="SizeBtn_Click"/>

                    <Rectangle Style="{DynamicResource LinearToolbarSeparator}"/>

                    <Button Content="↺90°" Style="{DynamicResource LinearToolButton}"
                            Click="RotateLeft_Click" ToolTip="向左旋转"/>
                    <Button Content="↻90°" Style="{DynamicResource LinearToolButton}"
                            Margin="3,0,0,0" Click="RotateRight_Click" ToolTip="向右旋转"/>

                    <Rectangle Style="{DynamicResource LinearToolbarSeparator}"/>

                    <Button Content="清空" Style="{DynamicResource LinearToolButton}"
                            Click="Clear_Click"/>
                    <Button Content="撤销" Style="{DynamicResource LinearToolButton}"
                            Margin="6,0,0,0" Click="Undo_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyBtn" Content="Copy"
                            Style="{DynamicResource LinearToolButton}"
                            Click="Copy_Click"/>
                    <Button x:Name="SaveBtn" Content="保存"
                            Style="{DynamicResource LinearPrimaryButton}"
                            Margin="6,0,0,0" Click="Save_Click"/>
                    <!-- Cancel removed: the X button in the title bar
                         is the close affordance now. Saves a slot
                         and keeps the right cluster focused on
                         the primary action. -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: viewer + pen-canvas overlay + mosaic preview
             rectangle. The Rectangle is the live preview while
             the user drags out a mosaic region; IsHitTestVisible=
             False so the underlying PenCanvas keeps receiving
             mouse events. -->
        <Grid Grid.Row="2" Background="{StaticResource SurfaceCanvas}" ClipToBounds="True">
            <controls:SkiaImageViewer x:Name="SkiaViewer"/>
            <Canvas x:Name="PenCanvas" Background="Transparent"
                    IsHitTestVisible="{Binding IsChecked, ElementName=PenToggle}"
                    MouseLeftButtonDown="PenCanvas_MouseLeftButtonDown"
                    MouseMove="PenCanvas_MouseMove"
                    MouseLeftButtonUp="PenCanvas_MouseLeftButtonUp"
                    MouseWheel="PenCanvas_MouseWheel">
                <Rectangle x:Name="MosaicPreviewRect"
                           Stroke="#FF3a4099" StrokeThickness="1"
                           StrokeDashArray="4 2"
                           Fill="Transparent"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
            </Canvas>
        </Grid>

        <!-- Row 3: bottom bar. -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfacePanel}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText"
                           Text="Ready"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="FitBtn" Content="Fit"
                            Style="{DynamicResource LinearToolButton}"
                            Click="FitBtn_Click"/>
                    <Slider x:Name="ZoomSlider" Width="180"
                            Style="{DynamicResource LinearSlider}"
                            Minimum="0.05" Maximum="5" Value="1.0"
                            Margin="12,0,8,0"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%"
                               Style="{StaticResource LinearSubtleLabel}"
                               Width="44" TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                                Foreground="{StaticResource TextPrimary}"/>
                    <Button x:Name="ZoomOutBtn" Content="−"
                            Style="{DynamicResource LinearToolButton}"
                            Margin="0,0,0,0"
                            Click="ZoomOutBtn_Click"/>
                    <Button x:Name="ZoomInBtn" Content="+"
                            Style="{DynamicResource LinearToolButton}"
                            Margin="4,0,0,0"
                            Click="ZoomInBtn_Click"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="OcrBtn" Content="OCR"
                        Style="{DynamicResource LinearToolButton}"
                        Click="Ocr_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
