<UserControl x:Class="ApertureNeo.Views.FolderTreePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:tree="clr-namespace:ApertureNeo.Controls.FolderTree;assembly="
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="232">
    <Border x:Name="TreePanel" Background="{StaticResource SurfaceElevated}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0 hosts all four navigation chips (back /
                     forward left, "up one level" + home right, all
                     icon-only). Row 1 is the tree itself. Round AA:
                     the home chip moved UP from the bottom row into
                     the right chip group, so Row 2 is gone. -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Floating chips row (Round AA): all four navigation
                 actions as ICON-ONLY buttons — back/forward on the
                 LEFT, "up one level" + "home" on the RIGHT — with
                 hover ToolTips carrying the human-readable labels.
                 Visibility predicates are unchanged:
                   - "back"    = CanGoBack   (browse history != home)
                   - "forward" = CanGoForward (a Back can be retraced)
                   - "up"      = IsDrillMode
                   - "home"    = IsDrillMode (same group as up) -->
            <Grid Grid.Row="0" Margin="8,8,8,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnTreeBack"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource LinearFloatingChip}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{DynamicResource FolderTree_DrillChipBack}">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnTreeForward"
                            Command="{Binding ForwardCommand}"
                            Margin="6,0,0,0"
                            Style="{StaticResource LinearFloatingChip}"
                            Visibility="{Binding CanGoForward, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{DynamicResource FolderTree_DrillChipForward}">
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnTreeUp"
                            Command="{Binding UpCommand}"
                            Style="{StaticResource LinearFloatingChip}"
                            Visibility="{Binding IsDrillMode, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{DynamicResource FolderTree_DrillChipUp}">
                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnReturnToRoot"
                            Command="{Binding ReturnToRootCommand}"
                            Margin="6,0,0,0"
                            Style="{StaticResource LinearFloatingChip}"
                            Visibility="{Binding IsDrillMode, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{DynamicResource FolderTree_DrillChipReturnToRoot}">
                        <ui:SymbolIcon Symbol="Home24" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Background="Transparent"
                          VerticalScrollBarVisibility="Auto">
                <tree:FolderTreeView x:Name="FolderTree"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     Padding="0,4">
                    <tree:FolderTreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource LinearTreeIcon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <Binding Path="IsMouseOver"
                                                                 RelativeSource="{RelativeSource AncestorType=tree:FolderItemContainer}"/>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=tree:FolderItemContainer}"/>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground" Value="{StaticResource SelectionFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="500"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="600"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEmptyHint}" Value="True">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="400"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextQuat}"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=tree:FolderItemContainer}"/>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground" Value="{StaticResource SelectionFg}"/>
                                                    <Setter Property="FontWeight" Value="600"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </tree:FolderTreeView.ItemTemplate>
                    <tree:FolderTreeView.ItemContainerStyle>
                        <Style TargetType="tree:FolderItemContainer" BasedOn="{StaticResource LinearFolderItemContainer}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </tree:FolderTreeView.ItemContainerStyle>
                </tree:FolderTreeView>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>