<Window x:Class="ApertureNeo.Views.HeadlessOcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource HeadlessOcr_Heading}"
        Width="640" Height="680"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="True"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="HarmonyOS Sans SC, HarmonyOS Sans, Microsoft YaHei UI, Segoe UI, Arial"
        Foreground="#FF1a1a1a">

    <!-- The Linear design tokens and button styles are merged into
         Application.Resources by App.xaml (Styles/Buttons.xaml,
         Styles/Tag.xaml for LinearDot, plus DesignTokens.xaml).
         WPF's StaticResource lookup walks up the visual/logical
         tree, so all StaticResource references in this Window
         resolve from the application scope.

         Note: this Window uses the main exe's button styles
         (LinearPrimaryButton / LinearCloseButton / LinearWindowButton),
         NOT the OCR plugin's identically-named-but-different styles
         (LinearPrimaryCta / LinearCloseIconButton / LinearGhostButton
         in Plugins.Ocr.Ui/DesignTokens.xaml). The two naming
         conventions diverged before this window was written. The
         main exe styles are visually similar — same 28px height,
         12px font, indigo primary — so the look is consistent
         across single-file and multi-file OCR windows. -->

    <Window.Resources>
        <!-- LinearDot (Styles/Tag.xaml) and all Brushes/Fonts/
             CornerRadius (DesignTokens.xaml) are found in
             Application.Resources via WPF's StaticResource lookup.
             The eyebrow/value/monoValue text styles below mirror
             the OCR plugin's DesignTokens so this window's subtitle
             reads identically to the single-file OcrResultWindow.
             They're inlined here because the main exe doesn't have
             its own LinearEyebrow/LinearValue/LinearMonoValue
             styles (those names live in the OCR UI's dictionary). -->
        <Style x:Key="LinearEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="510"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="LinearValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="510"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="LinearMonoValue" TargetType="TextBlock" BasedOn="{StaticResource LinearValue}">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontWeight" Value="400"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <!-- Same custom Window.Template as OcrResultWindow: single Border
         with rounded corners + drop shadow, asymmetric margin to give
         the 8px-deep shadow room on the bottom. -->
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Grid Margin="16,16,16,32">
                <Border CornerRadius="8"
                        Background="{StaticResource SurfaceCanvas}"
                        BorderBrush="{StaticResource BorderStrong}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <StaticResource ResourceKey="ShadowDialog"/>
                    </Border.Effect>
                    <ContentPresenter/>
                </Border>
            </Grid>
        </ControlTemplate>
    </Window.Template>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 44px title bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceCanvas}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="20,0,0,0">
                    <TextBlock Text="{DynamicResource HeadlessOcr_Heading}" FontSize="12" FontWeight="700"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderCount" Text="" FontSize="12" FontWeight="400"
                               Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,8,0"
                        Style="{StaticResource LinearCloseButton}" Click="BtnClose_Click">
                    <TextBlock Text="×" FontSize="16" FontWeight="400"
                               Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Body: subtitle + scrollable list of per-file sections -->
        <Grid Grid.Row="1" Margin="32,16,32,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Subtitle: how many succeeded + total elapsed time -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource HeadlessOcr_SummaryLabel}" Style="{StaticResource LinearEyebrow}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusDot" Style="{StaticResource LinearDot}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource HeadlessOcr_Ready}" Style="{StaticResource LinearValue}"/>
                    <TextBlock x:Name="MetaText" Style="{StaticResource LinearMonoValue}" Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Scrollable per-file sections -->
            <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FilesPanel" Orientation="Vertical"/>
            </ScrollViewer>
        </Grid>

        <!-- Footer: 复制全部 + 关闭 -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceCanvas}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8"
                Padding="20,12,32,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCopyAll" Style="{StaticResource LinearWindowButton}"
                        Content="{DynamicResource HeadlessOcr_CopyAll}" Click="BtnCopyAll_Click" Margin="0,0,8,0"
                        Padding="10,0" Width="Auto" Height="28"/>
                <Button x:Name="BtnClose" Style="{StaticResource LinearPrimaryButton}"
                        Content="{DynamicResource HeadlessOcr_Close}" Click="BtnClose_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>