<UserControl x:Class="ApertureNeo.Views.InfoPillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="32" d:DesignWidth="200">
    <Border x:Name="InfoPillContent"
            Background="{StaticResource SurfaceFloating}" BorderBrush="{StaticResource BorderStandard}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusPanel}" Padding="10,6"
            IsHitTestVisible="True"
            Cursor="Hand"
            MouseLeftButtonUp="InfoPillContent_MouseLeftButtonUp">
        <Border.Effect>
            <StaticResource ResourceKey="ShadowDialog"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- 8x8 status dot. Indigo once dimensions are
                 known, gray while the lazy header-probe is
                 still in flight. Color is set by the host via
                 InfoPillDotRef.Background. -->
            <Border x:Name="InfoPillDot" Style="{StaticResource LinearDot}"
                    Background="{StaticResource TextQuat}"
                    VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="ImageInfo" Text="" FontSize="12" FontWeight="600"
                       FontFamily="{StaticResource FontMono}"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>