<UserControl x:Class="ApertureNeo.Views.InfoPillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="32" d:DesignWidth="200">
    <Border x:Name="InfoPillContent"
            Background="{StaticResource SurfaceFloating}" BorderBrush="{StaticResource BorderStandard}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusPanel}" Padding="10,6"
            IsHitTestVisible="True"
            Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
        </Border.InputBindings>
        <Border.Effect>
            <StaticResource ResourceKey="ShadowDialog"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- 8x8 status dot. Color follows InfoPillViewModel
                 .IsDimensionsKnown via DataTrigger (indigo once
                 the probe lands, gray before). -->
            <Border x:Name="InfoPillDot"
                    Background="{StaticResource TextQuat}"
                    VerticalAlignment="Center" Margin="0,0,6,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource LinearDot}">
                        <Setter Property="Background" Value="{StaticResource TextQuat}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDimensionsKnown}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <TextBlock Text="{Binding ImageInfo}" FontSize="12" FontWeight="600"
                       FontFamily="{StaticResource FontMono}"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>