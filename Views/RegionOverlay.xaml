<Window x:Class="ApertureNeo.Views.RegionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True"
        ShowActivated="True"
        ShowInTaskbar="False" Cursor="Cross"
        Loaded="OnLoaded"
        KeyDown="Window_KeyDown">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="#01000000" IsHitTestVisible="True"
                 MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                 MouseMove="OverlayCanvas_MouseMove"
                 MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
            <!-- The four dim rectangles sit BEHIND the ActionBar
                 in z-order (declared first → painted first → hit-tested
                 last). They cover the whole screen so click events on
                 the dim region would still reach the Canvas and start a
                 drag — which is fine. But we explicitly mark them
                 IsHitTestVisible="False" so they NEVER swallow clicks
                 meant for the action bar; the parent Canvas receives
                 the click instead, but its background is the click-through
                 colour so the click falls through to whatever's beneath
                 (the desktop). The action bar's Border is declared AFTER
                 the Canvas in the same Grid, so it stacks on top and
                 gets clicks normally. -->
            <Rectangle x:Name="DimTop"    Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimBottom" Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimLeft"   Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimRight"  Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="SelRect"   Stroke="White" StrokeThickness="2"
                       StrokeDashArray="4,2" Fill="Transparent"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Canvas>
        <Border x:Name="ActionBar" Background="#DD1E1E1E" CornerRadius="6" Padding="8,5"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ActionBarText" Text="Drag to select area" Foreground="White"
                           VerticalAlignment="Center" Margin="6,0,8,0" FontSize="12"/>
                <!-- Explicit Linear styles. The default WPF-UI
                     Button template (forced via the merged
                     ControlsDictionary in App.xaml) renders
                     dark text on a dark themed background, which
                     makes the buttons look unclickable. The
                     tool buttons use LinearDarkToolButton so
                     the text is white (readable on this
                     dark ActionBar) rather than the near-black
                     text of the base LinearToolButton (designed
                     for light surfaces). -->
                <Button x:Name="ConfirmBtn" Content="Confirm" Padding="12,4" Margin="2,0"
                        Style="{StaticResource LinearPrimaryButton}"
                        IsEnabled="False" Click="ConfirmBtn_Click"/>
                <Button x:Name="FullscreenBtn" Content="Fullscreen (F)" Padding="12,4" Margin="2,0"
                        Style="{StaticResource LinearDarkToolButton}"
                        Click="FullscreenBtn_Click"/>
                <Button x:Name="OcrBtn" Content="OCR (O)" Padding="12,4" Margin="2,0"
                        Style="{StaticResource LinearDarkToolButton}"
                        Click="OcrBtn_Click"/>
                <Button x:Name="CancelBtn" Content="Cancel" Padding="12,4" Margin="2,0"
                        Style="{StaticResource LinearDarkToolButton}"
                        Click="CancelBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>