<Window x:Class="ApertureNeo.Views.RegionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True"
        ShowActivated="True"
        ShowInTaskbar="False" Cursor="Cross"
        Loaded="OnLoaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="#01000000" IsHitTestVisible="True"
                 MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                 MouseMove="OverlayCanvas_MouseMove"
                 MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
            <Rectangle x:Name="DimTop"    Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimBottom" Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimLeft"   Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="DimRight"  Fill="#80000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="SelRect"   Stroke="White" StrokeThickness="2"
                       StrokeDashArray="4,2" Fill="Transparent"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
            <!-- Floating action panel: Confirm + Cancel, positioned near selection -->
            <Border x:Name="FloatBar" Visibility="Collapsed" Background="#DD1E1E1E"
                    CornerRadius="6" Padding="10,6" IsHitTestVisible="True"
                    Canvas.ZIndex="10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmBtn" Content="Confirm" Padding="14,5" Margin="2,0"
                            Style="{StaticResource LinearPrimaryButton}"
                            IsEnabled="False" Click="ConfirmBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="Cancel" Padding="14,5" Margin="6,0,2,0"
                            Style="{StaticResource LinearDarkToolButton}"
                            Click="CancelBtn_Click"/>
                </StackPanel>
            </Border>
        </Canvas>
        <!-- Top bar: instruction text + fullscreen/OCR buttons -->
        <Border x:Name="ActionBar" Background="#DD1E1E1E" CornerRadius="6" Padding="8,5"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ActionBarText" Text="Drag to select an area" Foreground="White"
                           VerticalAlignment="Center" Margin="6,0,8,0" FontSize="12"/>
                <Button x:Name="FullscreenBtn" Content="Fullscreen (F)" Padding="12,4" Margin="2,0"
                        Style="{StaticResource LinearDarkToolButton}"
                        Click="FullscreenBtn_Click"/>
                <Button x:Name="OcrBtn" Content="OCR (O)" Padding="12,4" Margin="2,0"
                        Style="{StaticResource LinearDarkToolButton}"
                        Click="OcrBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>