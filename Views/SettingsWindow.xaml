<Window x:Class="ApertureNeo.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ApertureNeo.ViewModels"
        Title="设置"
        Width="780" Height="540"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource FontPrimary}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DesignTokens.xaml"/>
                <ResourceDictionary Source="/Styles/Annotation.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Sidebar item template: indented text, current row
                 bolded. The MainListBox itself applies a ContainerStyle. -->
            <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}" Margin="6,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1F000000"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFE0E1FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section title (smaller, secondary colour) -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="700"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="SectionSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Grid Margin="14">
                <Border CornerRadius="8"
                        Background="{StaticResource SurfaceCanvas}"
                        BorderBrush="{StaticResource BorderStrong}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <StaticResource ResourceKey="ShadowDialog"/>
                    </Border.Effect>
                    <ContentPresenter/>
                </Border>
            </Grid>
        </ControlTemplate>
    </Window.Template>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCanvas}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="设置"
                           FontSize="14" FontWeight="700"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <!-- LinearCloseButton (Buttons.xaml) — same
                         style as the main app's title bar close
                         button: 28x28, red destructive hover.
                         Previously used LinearCloseIconButton
                         (from Annotation.xaml) which doesn't set
                         Width/Height in its setters, so the
                         button shrank to its content size. -->
                    <Button x:Name="CloseBtn"
                            Style="{StaticResource LinearCloseButton}"
                            Width="28" Height="28" Margin="2,0,0,0"
                            Click="CloseBtn_Click">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Data="M4.39705 4.55379L4.46967 4.46967C4.73594 4.2034 5.1526 4.1792 5.44621 4.39705L5.53033 4.46967L12 10.939L18.4697 4.46967C18.7626 4.17678 19.2374 4.17678 19.5303 4.46967C19.8232 4.76256 19.8232 5.23744 19.5303 5.53033L13.061 12L19.5303 18.4697C19.7966 18.7359 19.8208 19.1526 19.6029 19.4462L19.5303 19.5303C19.2641 19.7966 18.8474 19.8208 18.5538 19.6029L18.4697 19.5303L12 13.061L5.53033 19.5303C5.23744 19.8232 4.76256 19.8232 4.46967 19.5303C4.17678 19.2374 4.17678 18.7626 4.46967 18.4697L10.939 12L4.46967 5.53033C4.2034 5.26406 4.1792 4.8474 4.39705 4.55379L4.46967 4.46967L4.39705 4.55379Z"
                              Fill="{StaticResource TextSecondary}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: sidebar nav + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceCanvas}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,1,0"
                    Padding="0,8,0,0">
                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Single"
                         ItemContainerStyle="{StaticResource SettingsNavItem}">
                    <ListBoxItem Content="快捷键" IsSelected="True" Tag="shortcuts"/>
                    <ListBoxItem Content="OCR" Tag="ocr"/>
                    <ListBoxItem Content="截图" Tag="screenshot"/>
                    <ListBoxItem Content="插件" Tag="plugins"/>
                    <ListBoxItem Content="常规" Tag="general"/>
                </ListBox>
            </Border>

            <!-- Content panels -->
            <Grid Grid.Column="1">
                <!-- 快捷键 -->
                <ScrollViewer x:Name="ShortcutsPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}">
                            <Run Text="全局快捷键 — 无论主窗口是否聚焦都生效。点击 [录制] 后按下任意组合键即可。" />
                        </TextBlock>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Content="开机时自动启动"
                                      IsChecked="{Binding AutoStart}"
                                      FontSize="13"/>
                            <Button Grid.Column="1"
                                    Content="重置全部"
                                    Style="{StaticResource LinearToolButton}"
                                    Command="{Binding ResetAllShortcutsCommand}"
                                    Visibility="Collapsed"/>
                        </Grid>

                        <CheckBox Content="关闭主窗口时最小化到托盘(而非退出)"
                                  IsChecked="{Binding CloseToTray}"
                                  FontSize="13"
                                  Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12,8"
                                            Background="#FFF6F6F8"
                                            BorderBrush="#12000000"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource RowLabel}"/>
                                            <Border Grid.Column="1"
                                                    Background="#FFFFFFFF"
                                                    BorderBrush="#FF3a4099"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10,4"
                                                    MinWidth="140">
                                                <TextBlock Text="{Binding CurrentDisplay}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#FF1a1a1a"/>
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Content="录制"
                                                    Style="{StaticResource LinearToolButton}"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding StartRecordingCommand}"/>
                                            <Button Grid.Column="3"
                                                    Content="重置"
                                                    Style="{StaticResource LinearToolButton}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding ResetCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- OCR -->
                <ScrollViewer x:Name="OcrPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <TextBlock Text="OCR 行为" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}">
                            <Run Text="控制截图工具 OCR 按钮(以及 Ctrl+Alt+T) 的默认行为。"/>
                        </TextBlock>

                        <CheckBox Content="OCR 后弹出结果窗口"
                                  IsChecked="{Binding EditorOcrShowWindow}"
                                  FontSize="13"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="(关闭时,识别结果仅复制到剪贴板 — 快速路径)"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiary}"
                                   Margin="22,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 截图 -->
                <ScrollViewer x:Name="ScreenshotPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <TextBlock Text="截图" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}">
                            <Run Text="截图编辑器中保存对话框的默认起始目录。"/>
                        </TextBlock>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DefaultSaveDir, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     FontSize="13"/>
                            <Button Grid.Column="1"
                                    Content="浏览..."
                                    Style="{StaticResource LinearToolButton}"
                                    Margin="6,0,0,0"
                                    Command="{Binding BrowseSaveDirCommand}"/>
                        </Grid>
                        <TextBlock Text="(留空则使用系统默认: %USERPROFILE%\Pictures\ApertureNeo\Screenshots)"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiary}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 插件 -->
                <ScrollViewer x:Name="PluginsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <TextBlock Text="插件" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionSubtitle}">
                            <Run Text="已安装的插件。勾选启用 — 状态点表示插件当前的可用性。" />
                        </TextBlock>
                        <TextBlock Text="{Binding PluginDiagnosticText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiary}"
                                   Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            Background="#FFF6F6F8"
                                            BorderBrush="#12000000"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 8×8 status dot. Color bound from
                                                 StatusBrush (mapped in the VM:
                                                 green=Enabled, red=Unavailable,
                                                 gray=Disabled). -->
                                            <Ellipse Grid.Column="0"
                                                     Width="10" Height="10"
                                                     Margin="0,4,10,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{Binding StatusBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="600" FontSize="13"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAvailable}"
                                                      VerticalAlignment="Center"
                                                      Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 常规 -->
                <ScrollViewer x:Name="GeneralPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18,24,18">
                        <TextBlock Text="常规" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="(更多设置即将推出 — 主题/语言等)"
                                   Style="{StaticResource SectionSubtitle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCanvas}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8"
                Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="设置自动保存到 %APPDATA%\ApertureNeo\settings.json"
                           FontSize="11"
                           Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center"/>
                <!-- Bottom-right "关闭" button removed (decision 2):
                     the top-right × button is the canonical close
                     affordance, so a second bottom-right button is
                     redundant and breaks the 28x28 visual rhythm. -->
            </DockPanel>
        </Border>
    </Grid>
</Window>