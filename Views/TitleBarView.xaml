<UserControl x:Class="ApertureNeo.Views.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="44" d:DesignWidth="1200">
    <Border x:Name="TitleBarArea" Background="{StaticResource SurfaceCanvas}"
            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: open + sidebar toggles. Open + toggles are
                 bound to TitleBarViewModel commands (P2); the
                 click handler attributes are gone. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                <Button Style="{StaticResource LinearPrimaryButton}" Command="{Binding OpenCommand}"
                        Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12"/>
                        <TextBlock Text="{DynamicResource TitleBar_Open}" Margin="5,0,0,0" FontSize="12" FontWeight="600"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnToggleTree" Style="{StaticResource LinearWindowButton}" Command="{Binding ToggleTreeColumnCommand}"
                        Margin="2,0,0,0">
                    <ui:SymbolIcon Symbol="NavigationLocationTarget20" FontSize="16"/>
                </Button>
                <Button x:Name="BtnToggleThumb" Style="{StaticResource LinearWindowButton}" Command="{Binding ToggleThumbColumnCommand}"
                        Margin="2,0,0,0">
                    <ui:SymbolIcon Symbol="Grid20" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- Center: app name -->
            <TextBlock Grid.Column="1" Text="Aperture Neo"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" FontSize="15" FontWeight="700"
                       IsHitTestVisible="False"/>

            <!-- Right: overflow menu + window controls. Menu items
                 are bound to TitleBarViewModel commands. Window
                 controls (Min/Max/Close) stay in the view's
                 code-behind because they touch the parent
                 Window's HWND state directly. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:Name="BtnMenu" Style="{StaticResource LinearWindowButton}" Click="BtnMenu_Click"
                        Margin="0,0,2,0">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource TitleBar_ClearCache}" Tag="destructive">
                                <MenuItem Header="{DynamicResource TitleBar_ClearThumbCache}" Command="{Binding ClearThumbnailCacheCommand}"/>
                                <MenuItem Header="{DynamicResource TitleBar_ClearRecent}" Command="{Binding ClearRecentCommand}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{DynamicResource TitleBar_Plugins}" x:Name="MenuPlugins"/>
                            <Separator/>
                            <MenuItem x:Name="MenuAbout" Command="{Binding OpenAboutCommand}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource TitleBar_About}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AboutUpdateSuffix" Text="{DynamicResource TitleBar_UpdateAvailableSuffix}"
                                                   Margin="8,0,0,0" FontSize="11" FontWeight="700"
                                                   Foreground="#FF16a34a" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Rectangle Width="1" Height="20" Fill="{StaticResource BorderStandard}" Margin="6,0"/>
                <Button x:Name="BtnMinimize" Style="{StaticResource LinearWindowButton}" Click="BtnMinimize_Click">
                    <ui:SymbolIcon Symbol="Subtract24" FontSize="14"/>
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource LinearWindowButton}" Click="BtnMaximize_Click">
                    <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Square24" FontSize="14"/>
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource LinearCloseButton}" Click="BtnClose_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>